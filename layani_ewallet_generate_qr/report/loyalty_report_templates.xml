<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layani_ewallet_generate_qr.generate_qr_code">
        <t t-call="web.html_container">
          <div class="page" t-att-style="padding_page">
            <t t-set="qr_size" t-value="'width:150px;height:150px;'"/>
              <t t-foreach="docs" t-as="loyalty">
                <div style="display: inline-block; page-break-inside: avoid; border: 1px solid black; padding: 10px; text-align: center; border-radius: 5pt;">
                   <table>
                       <tr>
                           <td>
                                <div t-field="loyalty.code" t-options="{'widget': 'barcode', 'symbology': 'QR', 'img_style': qr_size}"/>
                                 <br />
                                <t t-esc="loyalty.code" />
                           </td>
                       </tr>
                   </table>
                 </div>
              </t>
          </div>
        </t>
    </template>

    <template id="generate_qr_code_report_i18n">
        <t t-call="web.html_container">
            <t t-set="padding_page" t-value="'padding: 0mm 15mm'"/>
            <t t-call="layani_ewallet_generate_qr.generate_qr_code"/>
        </t>
    </template>
</odoo>